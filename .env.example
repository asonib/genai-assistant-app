# Copy to .env (repo root) and fill in. Never commit .env.

# ---- Django ----
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
APP_LOG_LEVEL=INFO
# LOG_DIR=./backend/logs
# SQLITE_PATH=./backend/db.sqlite3

# ---- LLM (Anthropic Claude) ----
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---- RAG ----
# VECTOR_STORE_DIR=./backend/vector_store
# EMBEDDING_CACHE_DIR=./.hf_cache

# ---- External tools (custom MCP server) ----
MCP_ENABLED=True
# stdio: backend spawns `python mcp_server/server.py` per tool call (no extra process to run)
# http : run `python mcp_server/server.py --transport http` and point MCP_SERVER_URL at it
MCP_TRANSPORT=stdio
# MCP_SERVER_COMMAND=python
# MCP_SERVER_ARGS=mcp_server/server.py
MCP_SERVER_URL=http://127.0.0.1:8765/mcp

# ---- Streamlit frontend ----
BACKEND_URL=http://127.0.0.1:8000/api
SESSION_IDLE_MINUTES=30
